---
const PAGE_TITLE_ID = '_top'; // matches Starlight's internal constant
import { TAGS, tagHref, tagLabel, isOverdue } from '../data/tags';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & {
	reviewed: Date;
	owner: string;
	tags: string[];
	status: 'draft' | 'stable' | 'placeholder';
	reviewEveryMonths: number;
};
const isSplash = data.template === 'splash';

for (const t of data.tags ?? []) {
	if (!(t in TAGS)) throw new Error(`Unknown tag "${t}" in ${entry.id}. Add it to src/data/tags.ts first.`);
}
const reviewed = data.reviewed;
const overdue = isOverdue(reviewed, data.reviewEveryMonths);
const fmt = reviewed.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const statusLabel = { draft: 'Draft', stable: 'Stable', placeholder: 'Placeholder' }[data.status];
---

<h1 id={PAGE_TITLE_ID} class:list={{ 'sr-only': isSplash }}>{data.title}</h1>
{
	!isSplash && (
		<div class="pb-meta" aria-label="Page metadata">
			<span class:list={['pb-chip', `pb-status-${data.status}`]}>{statusLabel}</span>
			<span class:list={['pb-reviewed', { overdue }]} title={`Review cadence: every ${data.reviewEveryMonths} month(s)`}>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
				Last reviewed <time datetime={reviewed.toISOString().slice(0, 10)}>{fmt}</time>
				{overdue && <strong> · review overdue</strong>}
			</span>
			<span class="pb-owner">Owner: {data.owner}</span>
			{data.tags?.length > 0 && (
				<span class="pb-tags">
					{data.tags.map((t) => (
						<a class="pb-tag" href={tagHref(t)}>#{tagLabel(t)}</a>
					))}
				</span>
			)}
		</div>
	)
}

<style>
	h1 {
		margin-top: 1rem;
		font-family: var(--pb-font-display);
		font-size: var(--sl-text-h1);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		font-variation-settings: 'opsz' 96;
	}
	.sr-only {
		position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
		overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
	}
	.pb-meta {
		display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem;
		margin-top: 0.9rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3);
	}
	.pb-chip {
		text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; font-size: 0.66rem;
		padding: 0.18rem 0.55rem; border-radius: 999px; border: 1px solid currentColor;
	}
	.pb-status-stable { color: var(--pb-ok); }
	.pb-status-draft { color: var(--pb-warn); }
	.pb-status-placeholder { color: var(--sl-color-gray-3); border-style: dashed; }
	.pb-reviewed { display: inline-flex; align-items: center; gap: 0.3rem; }
	.pb-reviewed svg { color: var(--sl-color-accent); }
	.pb-reviewed.overdue { color: var(--pb-warn); }
	.pb-tags { display: inline-flex; flex-wrap: wrap; gap: 0.35rem; }
	.pb-tag {
		text-decoration: none; color: var(--sl-color-accent-high); background: var(--sl-color-accent-low);
		padding: 0.12rem 0.5rem; border-radius: 0.4rem; font-weight: 500;
	}
	.pb-tag:hover { filter: brightness(1.1); text-decoration: underline; }
</style>
