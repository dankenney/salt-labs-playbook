{
  "name": "ai-first-sustainability-playbook",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "review:due": "node scripts/review-due.mjs",
    "screenshots": "python3 scripts/screenshots.py",
    "astro": "astro",
    "publish:docs": "astro build && rm -rf docs && cp -r dist docs && touch docs/.nojekyll"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.10",
    "sharp": "^0.35.3",
    "starlight-links-validator": "^0.26.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "description": "Practical, tactical playbook for running a climate change and sustainability services practice AI-first.",
  "engines": {
    "node": ">=22.12.0"
  }
}
